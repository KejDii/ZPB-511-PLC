FUNCTION "VecDivVal" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      A : Array[0.."n"] of Real;
      val : Real;
   END_VAR

   VAR_OUTPUT 
      C : Array[0.."n"] of Real;
   END_VAR

   VAR_TEMP 
      i : DInt;
      j : DInt;
   END_VAR


BEGIN
	FOR #i := 0 TO "n" DO
	    #C[#i] := #A[#i] / #val;
	END_FOR;
	
END_FUNCTION

FUNCTION "MulVecRowVecCol" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      A : Array[0.."n"] of Real;
      B : Array[0.."n"] of Real;
   END_VAR

   VAR_OUTPUT 
      s : Real;
   END_VAR

   VAR_TEMP 
      i : DInt;
   END_VAR


BEGIN
	#s := 0.0;
	FOR #i := 0 TO "n" DO
	    #s := #s + #A[#i] * #B[#i];
	END_FOR;
	
END_FUNCTION

FUNCTION "MulVecColVecRow" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      A : Array[0.."n"] of Real;
      B : Array[0.."n"] of Real;
   END_VAR

   VAR_OUTPUT 
      C : Array[0.."n", 0.."n"] of Real;
   END_VAR

   VAR_TEMP 
      i : DInt;
      j : DInt;
   END_VAR


BEGIN
	FOR #i := 0 TO "n" DO
	    FOR #j := 0 TO "n" DO
	        #C[#i, #j] := #A[#i] * #B[#j];
	    END_FOR;
	END_FOR;
	
END_FUNCTION

FUNCTION "MulMatVecCol" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      A : Array[0.."n", 0.."n"] of Real;
      B : Array[0.."n"] of Real;
   END_VAR

   VAR_OUTPUT 
      C : Array[0.."n"] of Real;
   END_VAR

   VAR_TEMP 
      i : DInt;
      j : DInt;
      k : DInt;
   END_VAR


BEGIN
	"VecFilled"(val := 0.0,
	            C => #C);
	
	FOR #i := 0 TO "n" DO
	    FOR #j := 0 TO "n" DO
	        #C[#i] := #C[#i] + #A[#i, #j] * #B[#j];
	    END_FOR;
	END_FOR;
	
END_FUNCTION

DATA_BLOCK "Scheduler"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      tm_break : Bool;
      flag_global : UDInt;
      flag_iter : UDInt;
      time_start {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      time_bound : UDInt;   // 50ms
      time_check {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      time_duration : UDInt;
   END_VAR


BEGIN
   time_bound := 50000000;

END_DATA_BLOCK

FUNCTION "MatDivVal" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      A : Array[0.."n", 0.."n"] of Real;
      val : Real;
   END_VAR

   VAR_OUTPUT 
      C : Array[0.."n", 0.."n"] of Real;
   END_VAR

   VAR_TEMP 
      i : DInt;
      j : DInt;
   END_VAR


BEGIN
	FOR #i := 0 TO "n" DO
	    FOR #j := 0 TO "n" DO
	        #C[#i, #j] := #A[#i, #j] / #val;
	    END_FOR;
	END_FOR;
	
END_FUNCTION

FUNCTION "MulMatMat" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      A : Array[0.."n", 0.."n"] of Real;
      B : Array[0.."n", 0.."n"] of Real;
   END_VAR

   VAR_OUTPUT 
      C : Array[0.."n", 0.."n"] of Real;
   END_VAR

   VAR_TEMP 
      i : DInt;
      j : DInt;
      k : DInt;
   END_VAR


BEGIN
	"MatFilled"(val := 0,
	            C => #C);
	
	FOR #i := 0 TO "n" DO
	    FOR #j := 0 TO "n" DO
	        FOR #k := 0 TO "n" DO
	            #C[#i, #j] := #C[#i, #j] + #A[#i, #k] * #B[#k, #j];
	        END_FOR;
	    END_FOR;
	END_FOR;
	
END_FUNCTION

FUNCTION "EwrlsSetEps" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Phi : Array[0.."n"] of Real;
      Theta : Array[0.."n"] of Real;
   END_VAR

   VAR_IN_OUT 
      eps : Real;
   END_VAR

   VAR_TEMP 
      j : DInt;
      status : Int;
   END_VAR


BEGIN
	//if there is no break or this is the correct function
	IF (NOT "Scheduler".tm_break) OR ("Scheduler".tm_break AND "Scheduler".flag_iter = "Scheduler".flag_global) THEN
	    //correct function -> cancel the break
	    IF "Scheduler".tm_break THEN
	        "Scheduler".tm_break := FALSE;
	    END_IF;
	    
	    //local flag = global flag
	    "Scheduler".flag_iter := "Scheduler".flag_global;
	    
	    //time check
	    #status := RD_LOC_T("Scheduler".time_check);
	    IF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND + 1 THEN
	        "Scheduler".time_duration := 1_000_000_000 + "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    ELSIF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND THEN
	        "Scheduler".time_duration := "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    END_IF;
	    
	    //if computation time is too long then make a break
	    IF "Scheduler".time_duration > "Scheduler".time_bound THEN
	        "Scheduler".tm_break := TRUE;
	        RETURN;
	    ELSE
	        // Calculate residual error: eps(i) = y(i) - Phi(i)' * Theta(i-1)
	        #eps := "Db_1".Y["i"];
	        FOR #j := 0 TO "n" DO
	            #eps := #eps - #Phi[#j] * #Theta[#j];
	        END_FOR;
	    END_IF;
	    //iterate global flag
	    "Scheduler".flag_global := "Scheduler".flag_global + 1;
	END_IF;
	
END_FUNCTION

FUNCTION "EwrlsSetTheta" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      K : Array[0.."n"] of Real;
      eps : Real;
   END_VAR

   VAR_IN_OUT 
      Theta : Array[0.."n"] of Real;
   END_VAR

   VAR_TEMP 
      j : DInt;
      status : Int;
   END_VAR


BEGIN
	//if there is no break or this is the correct function
	IF (NOT "Scheduler".tm_break) OR ("Scheduler".tm_break AND "Scheduler".flag_iter = "Scheduler".flag_global) THEN
	    //correct function -> cancel the break
	    IF "Scheduler".tm_break THEN
	        "Scheduler".tm_break := FALSE;
	    END_IF;
	    
	    //local flag = global flag
	    "Scheduler".flag_iter := "Scheduler".flag_global;
	    
	    //time check
	    #status := RD_LOC_T("Scheduler".time_check);
	    IF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND + 1 THEN
	        "Scheduler".time_duration := 1_000_000_000 + "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    ELSIF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND THEN
	        "Scheduler".time_duration := "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    END_IF;
	    
	    //if computation time is too long then make a break
	    IF "Scheduler".time_duration > "Scheduler".time_bound THEN
	        "Scheduler".tm_break := TRUE;
	        RETURN;
	    ELSE
	        // Calculate parameter vector: Theta(i) = Theta(i-1) + K(i) * eps(i)
	        FOR #j := 0 TO "n" DO
	            #Theta[#j] := #Theta[#j] + #K[#j] * #eps;
	        END_FOR;
	    END_IF;
	    //iterate global flag
	    "Scheduler".flag_global := "Scheduler".flag_global + 1;
	END_IF;
	
END_FUNCTION

FUNCTION "EwrlsSetK" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      P : Array[0.."n", 0.."n"] of Real;
      Phi : Array[0.."n"] of Real;
      lambda : Real;
   END_VAR

   VAR_IN_OUT 
      K : Array[0.."n"] of Real;
   END_VAR

   VAR_TEMP 
      Vec1 : Array[0.."n"] of Real;
      div : Real;
      status : Int;
   END_VAR


BEGIN
	//if there is no break or this is the correct function
	IF (NOT "Scheduler".tm_break) OR ("Scheduler".tm_break AND "Scheduler".flag_iter = "Scheduler".flag_global) THEN
	    //correct function -> cancel the break
	    IF "Scheduler".tm_break THEN
	        "Scheduler".tm_break := FALSE;
	    END_IF;
	    
	    //local flag = global flag
	    "Scheduler".flag_iter := "Scheduler".flag_global;
	    
	    //time check
	    #status := RD_LOC_T("Scheduler".time_check);
	    IF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND + 1 THEN
	        "Scheduler".time_duration := 1_000_000_000 + "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    ELSIF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND THEN
	        "Scheduler".time_duration := "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    END_IF;
	    
	    //if computation time is too long then make a break
	    IF "Scheduler".time_duration > "Scheduler".time_bound THEN
	        "Scheduler".tm_break := TRUE;
	        RETURN;
	    ELSE
	        // Calculate K: K(i) = (P(i-1) * Phi(i)) / (lambda + Phi(i)' * P(i-1) * Phi(i))
	        "MulMatVecCol"(A := #P,
	                       B := #Phi,
	                       C => #Vec1);
	        "MulVecRowVecCol"(A := #Phi,
	                          B := #Vec1,
	                          s => #div);
	        #div := #div + #lambda;
	        "VecDivVal"(A := #Vec1,
	                    val := #div,
	                    C => #K);
	    END_IF;
	    //iterate global flag
	    "Scheduler".flag_global := "Scheduler".flag_global + 1;
	END_IF;
	
END_FUNCTION

FUNCTION "EwrlsSetPhi" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_OUTPUT 
      Phi : Array[0.."n"] of Real;
   END_VAR

   VAR_TEMP 
      j : DInt;
      status : Int;
   END_VAR


BEGIN
	//if there is no break or this is the correct function
	IF (NOT "Scheduler".tm_break) OR ("Scheduler".tm_break AND "Scheduler".flag_iter = "Scheduler".flag_global) THEN
	    //correct function -> cancel the break
	    IF "Scheduler".tm_break THEN
	        "Scheduler".tm_break := FALSE;
	    END_IF;
	    
	    //local flag = global flag
	    "Scheduler".flag_iter := "Scheduler".flag_global;
	    
	    //time check
	    #status := RD_LOC_T("Scheduler".time_check);
	    IF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND + 1 THEN
	        "Scheduler".time_duration := 1_000_000_000 + "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    ELSIF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND THEN
	        "Scheduler".time_duration := "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    END_IF;
	    
	    //if computation time is too long then make a break
	    IF "Scheduler".time_duration > "Scheduler".time_bound THEN
	        "Scheduler".tm_break := TRUE;
	        RETURN;
	    ELSE
	        // Set values inside regression vector: Phi(i) = [y(i-1) ... y(i-a+1) u(i-1) ... u(i-b+1)]
	        FOR #j := 0 TO "a" - 1 DO
	            #Phi[#j] := "Db_1".Y["i" - #j - 1];
	        END_FOR;
	        FOR #j := "a" TO "n" DO
	            #Phi[#j] := "Db_1".U["i" + "a" - #j - 1];
	        END_FOR;
	    END_IF;
	    //iterate global flag
	    "Scheduler".flag_global := "Scheduler".flag_global + 1;
	END_IF;
	
END_FUNCTION

FUNCTION "EwrlsSetP" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      K : Array[0.."n"] of Real;
      Phi : Array[0.."n"] of Real;
      lambda : Real;
   END_VAR

   VAR_IN_OUT 
      P : Array[0.."n", 0.."n"] of Real;
   END_VAR

   VAR_TEMP 
      Mat1 : Array[0.."n", 0.."n"] of Real;
      Mat2 : Array[0.."n", 0.."n"] of Real;
      Mat3 : Array[0.."n", 0.."n"] of Real;
      status : Int;
   END_VAR


BEGIN
	//if there is no break or this is the correct function
	IF (NOT "Scheduler".tm_break) OR ("Scheduler".tm_break AND "Scheduler".flag_iter = "Scheduler".flag_global) THEN
	    //correct function -> cancel the break
	    IF "Scheduler".tm_break THEN
	        "Scheduler".tm_break := FALSE;
	    END_IF;
	    
	    //local flag = global flag
	    "Scheduler".flag_iter := "Scheduler".flag_global;
	    
	    //time check
	    #status := RD_LOC_T("Scheduler".time_check);
	    IF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND + 1 THEN
	        "Scheduler".time_duration := 1_000_000_000 + "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    ELSIF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND THEN
	        "Scheduler".time_duration := "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    END_IF;
	    
	    //if computation time is too long then make a break
	    IF "Scheduler".time_duration > "Scheduler".time_bound THEN
	        "Scheduler".tm_break := TRUE;
	        RETURN;
	    ELSE
	        // Calculate P: P(i) = (P(i-1) - K(i) * Phi(i)' * P(i-1)) / lambda
	        "MulVecColVecRow"(A := #K,
	                          B := #Phi,
	                          C => #Mat1);
	        "MulMatMat"(A := #Mat1,
	                    B := #P,
	                    C => #Mat2);
	        "SubMatMat"(A := #P,
	                    B := #Mat2,
	                    C => #Mat3);
	        "MatDivVal"(A := #Mat3,
	                    val := #lambda,
	                    C => #P);
	    END_IF;
	    //iterate global flag
	    "Scheduler".flag_global := "Scheduler".flag_global + 1;
	END_IF;
	
END_FUNCTION

FUNCTION_BLOCK "ewrls"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      eps : Real;
      Phi : Array[0.."n"] of Real;
      K : Array[0.."n"] of Real;
      P : Array[0.."n", 0.."n"] of Real;
      Theta : Array[0.."n"] of Real;
      lambda : Real;
   END_VAR

   VAR_TEMP 
      j : DInt;
      div : Real;
      Vec1 : Array[0.."n"] of Real;
      Mat1 : Array[0.."n", 0.."n"] of Real;
      Mat2 : Array[0.."n", 0.."n"] of Real;
      Mat3 : Array[0.."n", 0.."n"] of Real;
   END_VAR


BEGIN
	// At the end, the coefficients will be in "Db_1".Theta
	// does approx 117-118 iterations per default cycle (not scheduled)
	WHILE "i" <= "M" DO
	    // Set values inside regression vector: Phi(i) = [y(i-1) ... y(i-a+1) u(i-1) ... u(i-b+1)]
	    "EwrlsSetPhi"(Phi => #Phi);
	    // Calculate residual error: eps(i) = y(i) - Phi(i)' * Theta(i-1)
	    "EwrlsSetEps"(Phi := #Phi,
	                  Theta := #Theta,
	                  eps := #eps);
	    // Calculate K: K(i) = (P(i-1) * Phi(i)) / (lambda + Phi(i)' * P(i-1) * Phi(i))
	    "EwrlsSetK"(P := #P,
	                Phi := #Phi,
	                lambda := #lambda,
	                K := #K);
	    // Calculate parameter vector: Theta(i) = Theta(i-1) + K(i) * eps(i)
	    "EwrlsSetTheta"(K := #K,
	                    eps := #eps,
	                    Theta := #Theta);
	    // Calculate P: P(i) = (P(i-1) - K(i) * Phi(i)' * P(i-1)) / lambda
	    "EwrlsSetP"(K := #K,
	                Phi := #Phi,
	                lambda := #lambda,
	                P := #P);
	    IF NOT "Scheduler".tm_break THEN
	        "i" := "i" + 1;
	    ELSE
	        EXIT;
	    END_IF;
	END_WHILE;
	
END_FUNCTION_BLOCK

DATA_BLOCK "ewrls_DB"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
"ewrls"

BEGIN

END_DATA_BLOCK

FUNCTION "MatIdentity" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      val : Real;
   END_VAR

   VAR_OUTPUT 
      C : Array[0.."n", 0.."n"] of Real;
   END_VAR

   VAR_TEMP 
      i : DInt;
   END_VAR


BEGIN
	"MatFilled"(val := 0.0,
	            C => #C);
	FOR #i := 0 TO "n" DO
	    #C[#i, #i] := #val;
	END_FOR;
	
END_FUNCTION

FUNCTION_BLOCK "calculate_mse"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

BEGIN
	"mean_squared_error" := "mean_squared_error" / DINT_TO_LREAL("M" + 1);
	
END_FUNCTION_BLOCK

FUNCTION_BLOCK "ewrls_initialization"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      c : Real;
   END_VAR


BEGIN
	"ewrls_DB".lambda := 1.00; // forgetting factor (=1 means no forgetting)
	#c := 1_000_000; //"large number" to initialize P
	"MatIdentity"(val := #c,
	              C => "ewrls_DB".P);
	// Pad input and output vectors with "n" zeros at the beginning
	"i" := MAX(IN1 := "a", IN2 := "b");
	"VecFilled"(val := 0.0,
	            C => "ewrls_DB".Theta);
	"mean_squared_error" := 0.0;
	"initEwrls" := FALSE;
	
END_FUNCTION_BLOCK

FUNCTION_BLOCK "mse"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      iter_error : LReal;
      j : DInt;
      status : Int;
   END_VAR


BEGIN
	WHILE "i" <= "M" DO
	    //if there is no break or this is the correct function
	    IF (NOT "Scheduler".tm_break) OR ("Scheduler".tm_break AND "Scheduler".flag_iter = "Scheduler".flag_global) THEN
	        //correct function -> cancel the break
	        IF "Scheduler".tm_break THEN
	            "Scheduler".tm_break := FALSE;
	        END_IF;
	        
	        //local flag = global flag
	        "Scheduler".flag_iter := "Scheduler".flag_global;
	        
	        //time check
	        #status := RD_LOC_T("Scheduler".time_check);
	        IF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND + 1 THEN
	            "Scheduler".time_duration := 1_000_000_000 + "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	        ELSIF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND THEN
	            "Scheduler".time_duration := "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	        END_IF;
	        
	        //if computation time is too long then make a break
	        IF "Scheduler".time_duration > "Scheduler".time_bound THEN
	            "Scheduler".tm_break := TRUE;
	        END_IF;
	        
	        //if there is no break - compute normally
	        IF NOT "Scheduler".tm_break THEN
	            #iter_error := "Db_1".Y["i"];
	            FOR #j := 0 TO "a" - 1 DO
	                #iter_error := #iter_error - "ewrls_DB".Theta[#j] * "Db_1".Y["i" - #j - 1];
	            END_FOR;
	            FOR #j := "a" TO "n" DO
	                #iter_error := #iter_error - "ewrls_DB".Theta[#j] * "Db_1".U["i" + "a" - #j - 1];
	            END_FOR;
	            #iter_error := #iter_error * #iter_error;
	            "mean_squared_error" := "mean_squared_error" + #iter_error;
	        END_IF;
	    END_IF;
	    
	    IF NOT "Scheduler".tm_break THEN
	        "i" := "i" + 1;
	    ELSE
	        EXIT;
	    END_IF;
	END_WHILE;
	
END_FUNCTION_BLOCK

