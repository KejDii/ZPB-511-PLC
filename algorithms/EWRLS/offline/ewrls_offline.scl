FUNCTION "VecFilled" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      val : Real;
   END_VAR

   VAR_OUTPUT 
      C : Array[0.."n"] of Real;
   END_VAR

   VAR_TEMP 
      i : DInt;
   END_VAR


BEGIN
	FOR #i := 0 TO "n" DO
	    #C[#i] := #val;
	END_FOR;
	
END_FUNCTION

FUNCTION "MatFilled" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      val : Real;
   END_VAR

   VAR_OUTPUT 
      C : Array[0.."n", 0.."n"] of Real;
   END_VAR

   VAR_TEMP 
      i : DInt;
      j : DInt;
   END_VAR


BEGIN
	FOR #i := 0 TO "n" DO
	    FOR #j := 0 TO "n" DO
	        #C[#i, #j] := #val;
	    END_FOR;
	END_FOR;
	
END_FUNCTION

FUNCTION "SubMatMat" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      A : Array[0.."n", 0.."n"] of Real;
      B : Array[0.."n", 0.."n"] of Real;
   END_VAR

   VAR_OUTPUT 
      C : Array[0.."n", 0.."n"] of Real;
   END_VAR

   VAR_TEMP 
      i : DInt;
      j : DInt;
   END_VAR


BEGIN
	FOR #i := 0 TO "n" DO
	    FOR #j := 0 TO "n" DO
	        #C[#i, #j] := #A[#i, #j] - #B[#i, #j];
	    END_FOR;
	END_FOR;
	
END_FUNCTION

