FUNCTION "ScalarLimit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      input : Real;   // input value
      min : Real;   // lower limit
      max : Real;   // upper limit
   END_VAR

   VAR_OUTPUT 
      C : Real;   // limited output
   END_VAR

   VAR_TEMP 
      status : Int;
   END_VAR


BEGIN
	// check scheduler state
	IF (NOT "Scheduler".tm_break) OR
	    ("Scheduler".tm_break AND "Scheduler".flag_iter = "Scheduler".flag_global) THEN
	    
	    // resume after break
	    IF "Scheduler".tm_break THEN
	        "Scheduler".tm_break := FALSE;
	    END_IF;
	    
	    // sync iteration flags
	    "Scheduler".flag_iter := "Scheduler".flag_global;
	    
	    // compute duration
	    #status := RD_LOC_T("Scheduler".time_check);
	    IF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND + 1 THEN
	        "Scheduler".time_duration :=
	        1_000_000_000 + "Scheduler".time_check.NANOSECOND -
	        "Scheduler".time_start.NANOSECOND;
	    ELSIF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND THEN
	        "Scheduler".time_duration :=
	        "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    END_IF;
	    
	    // timeout check
	    IF "Scheduler".time_duration > "Scheduler".time_bound THEN
	        "Scheduler".tm_break := TRUE;
	    END_IF;
	    
	    // saturation
	    IF NOT "Scheduler".tm_break THEN
	        
	        #C := #input;
	        
	        IF #C > #max THEN
	            #C := #max;
	        ELSIF #C < #min THEN
	            #C := #min;
	        END_IF;
	        
	    END_IF;
	    
	END_IF;
	
	// increment global flag
	"Scheduler".flag_global := "Scheduler".flag_global + 1;
	
	
END_FUNCTION

FUNCTION "ScalarRateLimit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      input : Real;
      last_value : Real;
      max_delta : Real;
   END_VAR

   VAR_OUTPUT 
      C : Real;
   END_VAR

   VAR_TEMP 
      delta : Real;
      status : Int;
   END_VAR


BEGIN
	//if there is no break or this is the correct function
	IF (NOT "Scheduler".tm_break) OR ("Scheduler".tm_break AND "Scheduler".flag_iter = "Scheduler".flag_global) THEN
	    //correct function -> cancel the break
	    IF "Scheduler".tm_break THEN
	        "Scheduler".tm_break := FALSE;
	    END_IF;
	    
	    //local flag = global flag
	    "Scheduler".flag_iter := "Scheduler".flag_global;
	    
	    //time check
	    #status := RD_LOC_T("Scheduler".time_check);
	    IF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND + 1 THEN
	        "Scheduler".time_duration := 1_000_000_000 + "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    ELSIF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND THEN
	        "Scheduler".time_duration := "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    END_IF;
	    
	    //if computation time is too long then make a break
	    IF "Scheduler".time_duration > "Scheduler".time_bound THEN
	        "Scheduler".tm_break := TRUE;
	    END_IF;
	    
	    //if there is no break - compute normally
	    IF NOT "Scheduler".tm_break THEN
	        #delta := #input - #last_value;
	        
	        IF #delta > #max_delta THEN
	            #C := #last_value + #max_delta;
	        ELSIF #delta < - #max_delta THEN
	            #C := #last_value - #max_delta;
	        ELSE
	            #C := #input;
	        END_IF;
	    ELSE
	        "Scheduler".flag_global := "Scheduler".flag_global + 1;
	        RETURN;
	    END_IF;
	END_IF;
	//iterate global flag
	"Scheduler".flag_global := "Scheduler".flag_global + 1;
	
END_FUNCTION

FUNCTION "ScalarScale" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      input : Real;   // input value
      a : Real;   // scale factor
      b : Real;   // offset
   END_VAR

   VAR_OUTPUT 
      C : Real;   // scaled output
   END_VAR

   VAR_TEMP 
      status : Int;
   END_VAR


BEGIN
	// check scheduler state
	IF (NOT "Scheduler".tm_break) OR
	    ("Scheduler".tm_break AND "Scheduler".flag_iter = "Scheduler".flag_global) THEN
	    
	    // resume after break
	    IF "Scheduler".tm_break THEN
	        "Scheduler".tm_break := FALSE;
	    END_IF;
	    
	     // sync iteration flags
	    "Scheduler".flag_iter := "Scheduler".flag_global;
	    
	    // read local time
	    #status := RD_LOC_T("Scheduler".time_check);
		
		// compute duration
	    IF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND + 1 THEN
	        "Scheduler".time_duration :=
	        1_000_000_000 + "Scheduler".time_check.NANOSECOND -
	        "Scheduler".time_start.NANOSECOND;
	    ELSIF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND THEN
	        "Scheduler".time_duration :=
	        "Scheduler".time_check.NANOSECOND - "Scheduler".time_start.NANOSECOND;
	    END_IF;
	    
	    // timeout check
	    IF "Scheduler".time_duration > "Scheduler".time_bound THEN
	        "Scheduler".tm_break := TRUE;
	    END_IF;
	    
	    // linear scaling
	    IF NOT "Scheduler".tm_break THEN
	        #C := #a * #input + #b;
	    END_IF;
	    
	END_IF;
	
	// increment global flag
	"Scheduler".flag_global := "Scheduler".flag_global + 1;
	
	
END_FUNCTION

