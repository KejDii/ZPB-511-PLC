DATA_BLOCK "Scheduler"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      tm_break : Bool;
      flag_global : DInt;
      flag_iter : DInt;
      time_start {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      time_bound : UDInt;
      time_check {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      time_duration : UDInt;
   END_VAR
BEGIN
   time_bound := 4000000000; // max computation time [ns]
END_DATA_BLOCK


FUNCTION "MatrixAdd" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      A : Array[1..1, 1..1] of Real;
      B : Array[1..1, 1..1] of Real;
   END_VAR
   VAR_OUTPUT 
      C : Array[1..1, 1..1] of Real;
   END_VAR
   VAR_TEMP 
      i : DInt;
      j : DInt;
      lb_1 : DInt;
      lb_2 : DInt;
      ub_1 : DInt;
      ub_2 : DInt;
      time_check : Time;
      status : Int;
   END_VAR
BEGIN
	//if there is no break or this is the correct function
	IF (NOT "Scheduler".tm_break) OR ("Scheduler".tm_break AND "Scheduler".flag_iter = "Scheduler".flag_global) THEN
	    IF "Scheduler".tm_break THEN
	        "Scheduler".tm_break := FALSE;
	    END_IF;
	    "Scheduler".flag_iter := "Scheduler".flag_global;
	    #status := RD_LOC_T("Scheduler".time_check);
	    IF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND + 1 THEN
	        "Scheduler".time_duration := 1_000_000_000 +
	            "Scheduler".time_check.NANOSECOND -
	            "Scheduler".time_start.NANOSECOND;
	    ELSIF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND THEN
	        "Scheduler".time_duration :=
	            "Scheduler".time_check.NANOSECOND -
	            "Scheduler".time_start.NANOSECOND;
	    END_IF;
	    IF "Scheduler".time_duration > "Scheduler".time_bound THEN
	        "Scheduler".tm_break := TRUE;
	    END_IF;
	    IF NOT "Scheduler".tm_break THEN
	        #C[1,1] := #A[1,1] + #B[1,1];
	    ELSE
	        "Scheduler".flag_global := "Scheduler".flag_global + 1;
	        RETURN;
	    END_IF;
	END_IF;
	"Scheduler".flag_global := "Scheduler".flag_global + 1;
END_FUNCTION

FUNCTION "MatrixAddVal" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      A : Array[1..1, 1..1] of Real;
      B : Real;
   END_VAR

   VAR_OUTPUT 
      C : Real;
   END_VAR

   VAR_TEMP 
      status : Int;
   END_VAR


BEGIN
	// if there is no break or this is the correct function
	IF (NOT "Scheduler".tm_break) OR
	   ("Scheduler".tm_break AND "Scheduler".flag_iter = "Scheduler".flag_global) THEN
	    
	    // correct function -> cancel the break
	    IF "Scheduler".tm_break THEN
	        "Scheduler".tm_break := FALSE;
	    END_IF;
	    
	    // local flag = global flag
	    "Scheduler".flag_iter := "Scheduler".flag_global;
	    
	    // time check
	    #status := RD_LOC_T("Scheduler".time_check);
	    IF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND + 1 THEN
	        "Scheduler".time_duration :=
	            1_000_000_000 +
	            "Scheduler".time_check.NANOSECOND -
	            "Scheduler".time_start.NANOSECOND;
	    ELSIF "Scheduler".time_check.SECOND = "Scheduler".time_start.SECOND THEN
	        "Scheduler".time_duration :=
	            "Scheduler".time_check.NANOSECOND -
	            "Scheduler".time_start.NANOSECOND;
	    END_IF;
	    
	    // if computation time is too long then make a break
	    IF "Scheduler".time_duration > "Scheduler".time_bound THEN
	        "Scheduler".tm_break := TRUE;
	    END_IF;
	    
	    // if there is no break - compute normally
	    IF NOT "Scheduler".tm_break THEN
	        #C := #A[1, 1] + #B;
	    END_IF;
	END_IF;
	
	// iterate global flag
	"Scheduler".flag_global := "Scheduler".flag_global + 1;
	
END_FUNCTION


