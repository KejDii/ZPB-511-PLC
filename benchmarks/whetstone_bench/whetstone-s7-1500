IF "Running" THEN
    "A" := 1;
    "B" := -1;
    "C" := -1;
    "D" := -1;
   
    
    //Start timer
    "StartTime" := TIME_TCK();
    FOR "I" := 1 TO "Iterations" DO
        "A" := ("A" + "B" + "C" - "D") * 0.499975;        
        "B" := ("A" + "B" - "C" + "D") * 0.499975;       
        "C" := ("A" - "B" + "C" + "D") * 0.499975;      
        "D" := (-"A" + "B" + "C" + "D") * 0.499975;        
        
    END_FOR;
    // End timer
    "EndTime" := TIME_TCK();
    "Duration" := "EndTime" - "StartTime";
    
    "Running" := FALSE;
END_IF;