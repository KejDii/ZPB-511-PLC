IF "Start" AND NOT "Koniec" THEN
    //reset sumy, czasu trwania benchmarka i liczby operacji
    "sum" := 3.0;
    "ile_czasu" := 0.0;
    "operacje" := 0.0;
    //"FLOPS" := 0.0;
    
    //czas rozpoczęcia benchmarku
    "tStart" := TIME_TCK();
    
    //główna pętla do obliczania liczby pi metodą Nilakanthy’ego, 9 operacji flop na 1 iteracje benchmarka
    FOR "i" := 1 TO "iteracje" DO
        "temp" := 4.0 / ((2.0 * "i") * (2.0 * "i" + 1.0) * (2.0 * "i" + 2.0));

        IF ("i" MOD 2) = 1 THEN
            "sum" := "sum" + "temp";
        ELSE
            "sum" := "sum" - "temp";
        END_IF;

    END_FOR;
    
    //obliczanie pi
    "pi" := "sum";
    
    //czas zakończenia benchmarku
    "tEnd" := TIME_TCK();
    
    //obliczanie czasu trwania
    "ile_czasu" := TIME_TO_LWORD("tEnd" - "tStart");
    
    //obliczanie liczby operacji zmiennoprzecinkowych we wszystkich operacjach
    "operacje" := 9.0 * ("iteracje"); //liczba operacji zmiennoprzwe wszystkich iteracjach
    
    //ustawianie flagi końca programu
    "Koniec" := TRUE;
END_IF;
