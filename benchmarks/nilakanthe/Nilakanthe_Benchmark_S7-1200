IF "Start" AND NOT "Koniec" THEN
    //reset sumy, czasu trwania i liczby operacji
    "sum" := 3.0;
    "ile_czasu" := 0;
    "operacje" := 0.0;
    //"FLOPS" := 0.0;
    
    //czas rozpoczęcia
    "czas_start" := RD_LOC_T(OUT => "Data_block_1".start);
    
    //główna pętla do obliczania liczby pi metodą Nilakanthy’ego, 9 operacji na 1 iteracje
    FOR "i" := 1 TO "iteracje" DO
        "temp" := 4.0 / ((2.0 * "i") * (2.0 * "i" + 1.0) * (2.0 * "i" + 2.0));
        
        IF ("i" MOD 2) = 1 THEN
            "sum" := "sum" + "temp";
        ELSE
            "sum" := "sum" - "temp";
        END_IF;
    END_FOR;
    
    //obliczanie pi
    "pi" := "sum";
    
    //czas zakończenia
    "czas_koniec" := RD_LOC_T(OUT => "Data_block_1".koniec);
    
    //obliczanie liczby operacji zmiennoprzecinkowych dla wszystkich iteracji
    "operacje" := 9.0 * ("iteracje");
    
    //ustawianie flagi końca programu
    "Koniec" := TRUE;
END_IF;
